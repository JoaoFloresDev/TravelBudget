    "onboarding.step1.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set what the trip can cost and see every day how much is left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cuánto puede costar el viaje y mira cada día cuánto queda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina quanto a viagem pode custar e veja todo dia quanto ainda resta."
          }
        }
      }
    },
    "onboarding.step1.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One budget per trip"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto por viaje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento por viagem"
          }
        }
      }
    },
    "onboarding.step2.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log expenses in the local currency — we convert with the day's rate, saved with each expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra en la moneda local — convertimos con el cambio del día, guardado en cada gasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre na moeda local — convertemos com o câmbio do dia, salvo em cada gasto."
          }
        }
      }
    },
    "onboarding.step2.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend in any currency"
