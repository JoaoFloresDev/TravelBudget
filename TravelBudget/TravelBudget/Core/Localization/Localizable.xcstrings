    "onboarding.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar"
          }
        }
      }
    },
    "onboarding.step1.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set what the trip can cost and see every day how much is left."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cuánto puede costar el viaje y mira cada día cuánto queda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina quanto a viagem pode custar e veja todo dia quanto ainda resta."
          }
        }
      }
    },
    "onboarding.step1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One budget per trip"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un presupuesto por viaje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um orçamento por viagem"
          }
        }
      }
    },
    "onboarding.step2.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log expenses in the local currency — we convert with the day's rate, saved with each expense."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra en la moneda local — convertimos con el cambio del día, guardado en cada gasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre na moeda local — convertemos com o câmbio do dia, salvo em cada gasto."
          }
        }
      }
    },
    "onboarding.step2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend in any currency"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasta en cualquier moneda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaste em qualquer moeda"
          }
        }
      }
    },
    "onboarding.step3.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget shows how much you can still spend today. No account, your data stays on your phone."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El widget muestra cuánto puedes gastar hoy. Sin cuenta, tus datos se quedan en tu móvil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O widget mostra quanto você ainda pode gastar hoje. Sem conta, seus dados ficam no seu celular."
          }
        }
      }
    },
    "onboarding.step3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily allowance, on your home screen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu saldo del día, en tu pantalla de inicio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu saldo do dia, na tela de início"
          }
        }
      }
    },
